{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "demo": {
      "root": "apps/demo",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "transcript-api",
          "format": "url",
          "env": "TRANSCRIPT_API_URL"
        }
      ]
    },
    "transcript-api": {
      "root": "services/transcript-api",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "transcript-api"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "transcript-api"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "transcript-api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "transcript-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "demo"
      }
    }
  ]
}
